# --------------------------------------------------
# Life-OS Master .gitignore
# --------------------------------------------------

# Agent Instructions and Internal Project Documentation
/docs/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Environment Variables & Secrets (CRITICAL for E2EE & Cloud APIs)
.env
.env.*
*.env
!*.env.example
secrets.json
secrets.h
credentials.json
*.pem
*.key
*.p12

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.sublime-project
*.sublime-workspace

# Flutter / Dart General
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
.packages
.packages.generated
flutter_*.png
*.ds

# Windows Flutter Specific
**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# macOS / iOS Flutter Specific
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id
**/ios/Runner/GeneratedPluginRegistrant.*
**/Pods/
**/.symlinks/

# Android Flutter Specific
**/.gradle/
**/android/**/gradle-wrapper.jar
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks

# Linux Flutter Specific
**/linux/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Embedded Hardware / ESP32 (PlatformIO / Arduino / ESP-IDF)
.pio/
.pioenvs/
.piolibdeps/
.esphome/
arduino_build/
*.bin
*.elf
*.hex

# Python / AI Model Testing Scripts (Kev / Groq tests)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Logs & Temporary files
*.log
*.tmp
*.bak
*.swp
