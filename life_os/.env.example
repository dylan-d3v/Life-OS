# ==============================================================================
# Life-OS: Variables de Entorno (Plantilla de Ejemplo)
# ==============================================================================
# Copia este archivo como `.env` (el cual está protegido en .gitignore)
# y reemplaza los valores con las credenciales de tu proyecto en Supabase.

# Supabase Configuration
# Puedes encontrar estos datos en: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# AI Services (para la Fase 4 de inferencia y STT/TTS)
GROQ_API_KEY=your-groq-api-key-here

